rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Connection test doc (read-only for boot verification)
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    // User profile
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);

      // User's calendar events
      match /events/{eventId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(eventId)
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 200
          && request.resource.data.startDate is string
          && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }

      // User's tasks
      match /tasks/{taskId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(taskId)
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 200
          && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
