# ── Server-only secrets ─────────────────────────────────────────────
# Set these in Vercel → Project → Settings → Environment Variables (and in a
# local .env file). They are read only by the server (/api) and are never
# bundled into the browser. Do NOT prefix them with VITE_.

# Required for Gemini AI. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Optional: pin a Gemini model (otherwise the built-in list is tried in order)
GEMINI_MODEL=""

# Optional: Firebase project used to verify signed-in users (defaults to this app's project)
FIREBASE_PROJECT_ID=""

# Local experiments only: set to "false" to skip the sign-in check on /api. Never on Vercel.
# REQUIRE_AUTH="false"

# ── Firebase web config (public, safe in the browser) ──────────────
# Optional overrides; by default these come from firebase-applet-config.json.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""
