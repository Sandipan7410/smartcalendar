{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "User ID matching auth UID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "photoURL": { "type": "string", "description": "User avatar photo URL" },
        "updatedAt": { "type": "string", "description": "Last update timestamp" }
      },
      "required": ["uid"]
    },
    "CalendarEvent": {
      "title": "CalendarEvent",
      "description": "Calendar event entity with offline persistence",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique event ID" },
        "userId": { "type": "string", "description": "Owner user ID" },
        "title": { "type": "string", "description": "Event title", "maxLength": 200 },
        "description": { "type": "string", "description": "Event notes or description", "maxLength": 2000 },
        "location": { "type": "string", "description": "Location or link", "maxLength": 500 },
        "startDate": { "type": "string", "description": "Start date YYYY-MM-DD" },
        "startTime": { "type": "string", "description": "Start time HH:MM" },
        "endDate": { "type": "string", "description": "End date YYYY-MM-DD" },
        "endTime": { "type": "string", "description": "End time HH:MM" },
        "isAllDay": { "type": "boolean", "description": "All day event flag" },
        "color": { "type": "string", "description": "Hex color code" },
        "calendarId": { "type": "string", "description": "Calendar category (personal, work, learning)" },
        "recurrence": { "type": "string", "description": "Recurrence rule" },
        "reminderMinutes": { "type": "number", "description": "Reminder minutes before event" },
        "isCompleted": { "type": "boolean", "description": "Completion flag" },
        "isGoogleCalendar": { "type": "boolean", "description": "Synced with Google Calendar" },
        "googleEventId": { "type": "string", "description": "Google Calendar Event ID" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["id", "title", "startDate", "startTime", "endDate", "endTime"]
    },
    "CalendarTask": {
      "title": "CalendarTask",
      "description": "Calendar task or todo item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique task ID" },
        "userId": { "type": "string", "description": "Owner user ID" },
        "title": { "type": "string", "description": "Task title", "maxLength": 200 },
        "notes": { "type": "string", "description": "Task notes", "maxLength": 1000 },
        "dueDate": { "type": "string", "description": "Due date YYYY-MM-DD" },
        "dueTime": { "type": "string", "description": "Due time HH:MM" },
        "priority": { "type": "string", "enum": ["high", "medium", "low"] },
        "calendarId": { "type": "string", "description": "Category" },
        "isCompleted": { "type": "boolean", "description": "Completion flag" },
        "completedAt": { "type": "string", "description": "Completion timestamp" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["id", "title", "isCompleted"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document"
    },
    "/users/{userId}/events/{eventId}": {
      "schema": "CalendarEvent",
      "description": "User private calendar events subcollection"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": "CalendarTask",
      "description": "User private tasks subcollection"
    }
  }
}
